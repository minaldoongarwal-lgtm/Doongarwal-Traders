# GEMINI_API_KEY: Optional for AI Inventory insights.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Transactional Email Service configuration (e.g., SendGrid, Resend, Mailgun)
# If provided, approved supplier orders are dispatched through the configured provider.
# If not configured, StockPulse uses high-fidelity transactional simulator with live logging and delivery receipts.
EMAIL_PROVIDER="sendgrid" # Options: sendgrid | resend | mailgun | simulated
SENDGRID_API_KEY=""
RESEND_API_KEY=""
MAILGUN_API_KEY=""
MAILGUN_DOMAIN=""
FROM_EMAIL="orders@mybusiness.com"
FROM_NAME="Store Operations - Inventory Manager"
